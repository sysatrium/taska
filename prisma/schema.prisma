generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Team {
  id            String   @id
  name          String   @unique
  ownerRole     String
  competencyIds String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Competency {
  id           String @id
  name         String
  isSelectable Boolean @default(true)
  source       String @default("seeded")
}
