{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/specs/004-team-profile-and-capacity/contracts/data-schema.json",
  "title": "Feature 004 Team Profile and Capacity Schemas",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "Team": { "$ref": "#/$defs/Team" },
    "TeamCreateRequest": { "$ref": "#/$defs/TeamCreateRequest" },
    "TeamPatchRequest": { "$ref": "#/$defs/TeamPatchRequest" },
    "Competency": { "$ref": "#/$defs/Competency" },
    "TeamListResponse": { "$ref": "#/$defs/TeamListResponse" },
    "CompetencyListResponse": { "$ref": "#/$defs/CompetencyListResponse" },
    "ErrorResponse": { "$ref": "#/$defs/ErrorResponse" }
  },
  "$defs": {
    "Team": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "ownerRole", "competencyIds", "createdAt", "updatedAt"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable global team identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Display name of the team"
        },
        "ownerRole": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Responsible role for the team profile"
        },
        "competencyIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "References to selectable competencies from the centralized catalog"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "TeamCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ownerRole", "competencyIds"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "ownerRole": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "competencyIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "TeamPatchRequest": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "ownerRole": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "competencyIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "Competency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "isSelectable", "source"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "isSelectable": {
          "type": "boolean",
          "const": true
        },
        "source": {
          "type": "string",
          "enum": ["seeded"]
        }
      }
    },
    "TeamListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/Team" }
        }
      }
    },
    "CompetencyListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/Competency" }
        }
      }
    },
    "ErrorDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "issue"],
      "properties": {
        "field": {
          "type": "string"
        },
        "issue": {
          "type": "string"
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": { "$ref": "#/$defs/ErrorDetail" }
        }
      }
    }
  }
}
