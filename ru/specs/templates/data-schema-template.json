{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/feature-data-schema.json",
  "title": "Шаблон схемы данных фичи",
  "description": "Шаблон для feature-level JSON schema артефактов, используемых в контрактах или валидации.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "status"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Замените на каноническое поле идентификатора."
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "archived"],
      "description": "Замените на допустимые бизнес-состояния."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "description": "Замените или удалите, если не нужно.",
      "additionalProperties": true
    }
  },
  "examples": [
    {
      "id": "obj_123",
      "status": "active",
      "createdAt": "2026-01-01T00:00:00Z",
      "updatedAt": "2026-01-02T00:00:00Z",
      "metadata": {
        "source": "template"
      }
    }
  ]
}
