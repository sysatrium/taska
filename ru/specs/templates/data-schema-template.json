{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Шаблон схемы данных фичи",
  "description": "Шаблон для feature-level data-контрактов. Замените плейсхолдеры реальной доменной схемой до начала реализации.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Стабильный идентификатор сущности"
    },
    "status": {
      "type": "string",
      "description": "Состояние жизненного цикла сущности"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Временная метка создания"
    }
  },
  "required": ["id", "status"],
  "$defs": {
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      },
      "required": ["code", "message"]
    }
  }
}
